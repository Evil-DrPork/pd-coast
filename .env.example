# Poker44 miner configuration (example)
# Copy to `.env` and adjust. Bittensor wallet, netuid, axon, and subtensor
# settings remain CLI flags; do not put wallet secrets in this file.

# Promotion-qualified V4.1 canary challenger.
P44_DETECTOR_VARIANT=v4
P44_MODEL_PATH=detection_model/artifacts/p44_v4_coherent.joblib
P44_PREDICTION_THRESHOLD=0.5
P44_REQUIRE_MODEL=1

# V4 already applies one deterministic, request-relative 10% boundary mapper.
# Keep the miner's legacy external top-K remapper disabled to avoid mapping twice.
P44_TOP_K=0
P44_TOP_K_FRAC=0

# Emit a warning if inference approaches the validator timeout budget.
P44_LATENCY_WARN_SECONDS=15

# Model name/version/framework, repo URL/commit, and local artifact hash are
# derived automatically from the selected variant and checkout. Set manifest
# URL overrides only after publishing an artifact/model card.
# P44_MANIFEST_ARTIFACT_URL=https://...
# P44_MANIFEST_MODEL_CARD_URL=https://...
# Verify this pin before joblib deserialization. Update it after retraining.
POKER44_MODEL_ARTIFACT_SHA256=10a8349930565d258cda80773a7cb876a1f944bd2aab9f8392466db428d965d9

# Example PowerShell launch:
# python neurons/miner.py --netuid <NETUID> --subtensor.network finney `
#   --wallet.name <coldkey> --wallet.hotkey <hotkey> `
#   --axon.port <PORT> --logging.debug

# Stable V3 rollback:
# P44_DETECTOR_VARIANT=v3
# P44_MODEL_PATH=detection_model/artifacts/miner_tabular_0.1.joblib
# P44_REQUIRE_MODEL=1
# POKER44_MODEL_ARTIFACT_SHA256=6cd4d97c4f66c330b82e5ff466e12283211d78bdf7f4de9cd80e1d8ec5daa92f
# P44_TOP_K=0
# P44_TOP_K_FRAC=0
